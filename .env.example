# Copier en .env (non versionné) et renseigner. Ne jamais commiter de vraie valeur.
ANTHROPIC_API_KEY=
# Modèle utilisé pour le bilan. Obligatoire : aucune valeur par défaut dans le code.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Clé locale de Screenpipe : npx -y screenpipe@latest auth token
SCREENPIPE_API_KEY=
SCREENPIPE_PORT=3035
SESSIONS_DIR=./sessions
